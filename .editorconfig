# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

[{*.bash_aliases,*.bash_aliases.tmpl}]
indent_style = tab

[{*.bashrc,*.bashrc.tmpl}]
indent_style = tab

# Allow tabs in JSON
[*.json]
indent_style = tab

[{*.toml,*.toml.tmpl}]
indent_style = tab
